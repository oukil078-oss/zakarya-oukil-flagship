generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  type      String   @default("General")
  message   String
  ipHash    String?
  userAgent String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  stack       String[]
  personas    String[]
  image       String
  liveUrl     String?
  sourceUrl   String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("projects")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  avatar    String?
  featured  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

model ProfileContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile_content")
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  label     String
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

model PersonaConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  accent      String
  accent2     String
  description String
  stats       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("persona_configs")
}
